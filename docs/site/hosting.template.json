{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Wharfie public documentation: private retained S3 origin and CloudFront; render edge code before deployment.",
  "Parameters": {
    "ContentSha256": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{64}$",
      "Description": "SHA-256 of the reviewed index.html uploaded to releases/<sha256>/index.html."
    },
    "CustomDomain": {
      "Type": "String",
      "Default": "",
      "AllowedValues": ["", "docs.wharfie.dev"],
      "Description": "Leave empty to verify the CloudFront staging hostname before DNS cutover."
    },
    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:acm:us-east-1:[0-9]{12}:certificate/[a-f0-9-]{36}$",
      "Description": "An issued ACM certificate in this AWS account and us-east-1 covering CustomDomain."
    }
  },
  "Rules": {
    "CustomDomainRequiresCertificate": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::And": [
                  { "Fn::Equals": [{ "Ref": "CustomDomain" }, ""] },
                  { "Fn::Equals": [{ "Ref": "CertificateArn" }, ""] }
                ]
              },
              {
                "Fn::And": [
                  {
                    "Fn::Not": [
                      { "Fn::Equals": [{ "Ref": "CustomDomain" }, ""] }
                    ]
                  },
                  {
                    "Fn::Not": [
                      { "Fn::Equals": [{ "Ref": "CertificateArn" }, ""] }
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Supply CustomDomain and CertificateArn together, or leave both empty for staging."
        }
      ]
    }
  },
  "Conditions": {
    "HasCustomDomain": {
      "Fn::Not": [{ "Fn::Equals": [{ "Ref": "CustomDomain" }, ""] }]
    }
  },
  "Resources": {
    "DocsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "wharfie-docs-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          { "Key": "project", "Value": "wharfie" },
          { "Key": "purpose", "Value": "public-docs" }
        ]
      }
    },
    "DocsOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "wharfie-docs-${AWS::AccountId}-${AWS::Region}"
          },
          "Description": "Signed read access to the private Wharfie documentation origin.",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "DocsRoutes": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": { "Fn::Sub": "wharfie-docs-${AWS::AccountId}-${AWS::Region}" },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Serve the reviewed docs revision and handle explicit retired routes.",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "__WHARFIE_DOCS_EDGE_CODE__",
        "Tags": [
          { "Key": "project", "Value": "wharfie" },
          { "Key": "purpose", "Value": "public-docs" }
        ]
      }
    },
    "DocsResponseHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "wharfie-docs-${AWS::AccountId}-${AWS::Region}"
          },
          "Comment": "No scripts, framing, forms, or external assets in the documentation landing page.",
          "SecurityHeadersConfig": {
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
              "Override": true
            },
            "ContentTypeOptions": { "Override": true },
            "FrameOptions": { "FrameOption": "DENY", "Override": true },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            }
          },
          "CustomHeadersConfig": {
            "Items": [
              {
                "Header": "Cache-Control",
                "Value": "no-store",
                "Override": true
              }
            ]
          }
        }
      }
    },
    "DocsDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Wharfie public documentation",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Aliases": {
            "Fn::If": [
              "HasCustomDomain",
              [{ "Ref": "CustomDomain" }],
              { "Ref": "AWS::NoValue" }
            ]
          },
          "Origins": [
            {
              "Id": "docs-s3",
              "DomainName": {
                "Fn::GetAtt": ["DocsBucket", "RegionalDomainName"]
              },
              "OriginAccessControlId": {
                "Fn::GetAtt": ["DocsOriginAccessControl", "Id"]
              },
              "S3OriginConfig": { "OriginAccessIdentity": "" }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "docs-s3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "PATCH",
              "POST",
              "DELETE"
            ],
            "CachedMethods": ["GET", "HEAD"],
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "ResponseHeadersPolicyId": { "Ref": "DocsResponseHeaders" },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": ["DocsRoutes", "FunctionMetadata.FunctionARN"]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            { "ErrorCode": 403, "ErrorCachingMinTTL": 0 },
            { "ErrorCode": 404, "ErrorCachingMinTTL": 0 }
          ],
          "ViewerCertificate": {
            "Fn::If": [
              "HasCustomDomain",
              {
                "AcmCertificateArn": { "Ref": "CertificateArn" },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              { "CloudFrontDefaultCertificate": true }
            ]
          }
        },
        "Tags": [
          { "Key": "project", "Value": "wharfie" },
          { "Key": "purpose", "Value": "public-docs" }
        ]
      }
    },
    "DocsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "DocsBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["DocsBucket", "Arn"] },
                { "Fn::Sub": "${DocsBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            },
            {
              "Sid": "AllowThisDistributionToReadDocumentationRevisions",
              "Effect": "Allow",
              "Principal": { "Service": "cloudfront.amazonaws.com" },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${DocsBucket.Arn}/releases/*/index.html"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DocsDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": { "Value": { "Ref": "DocsBucket" } },
    "DistributionId": { "Value": { "Ref": "DocsDistribution" } },
    "DistributionDomainName": {
      "Value": { "Fn::GetAtt": ["DocsDistribution", "DomainName"] }
    },
    "OriginAccessControlId": {
      "Value": { "Fn::GetAtt": ["DocsOriginAccessControl", "Id"] }
    }
  }
}
