{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Wharfie public documentation: retained S3 website bucket with two public HTML documents.",
  "Resources": {
    "DocsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "wharfie-docs-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": false,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": false
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "wharfie"
          },
          {
            "Key": "purpose",
            "Value": "public-docs"
          }
        ],
        "WebsiteConfiguration": {
          "IndexDocument": "index.html",
          "ErrorDocument": "404.html"
        }
      }
    },
    "DocsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DocsBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureOperationsExceptObjectReads",
              "Effect": "Deny",
              "Principal": "*",
              "NotAction": "s3:GetObject",
              "Resource": [
                {
                  "Fn::GetAtt": ["DocsBucket", "Arn"]
                },
                {
                  "Fn::Sub": "${DocsBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "DenyInsecureReadsOutsidePublicDocuments",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:GetObject",
              "NotResource": [
                {
                  "Fn::Sub": "${DocsBucket.Arn}/index.html"
                },
                {
                  "Fn::Sub": "${DocsBucket.Arn}/404.html"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "AllowPublicDocumentationReads",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": [
                {
                  "Fn::Sub": "${DocsBucket.Arn}/index.html"
                },
                {
                  "Fn::Sub": "${DocsBucket.Arn}/404.html"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "DocsBucket"
      }
    },
    "WebsiteURL": {
      "Value": {
        "Fn::GetAtt": ["DocsBucket", "WebsiteURL"]
      }
    }
  }
}
