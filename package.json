{
  "name": "@wharfie/wharfie",
  "version": "0.0.15",
  "description": "Experimental toolkit for building TypeScript CLIs and packaging them as portable Node SEA executables",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wharfie/wharfie.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wharfie/wharfie/issues"
  },
  "bin": {
    "wharfie": "./bin/wharfie"
  },
  "homepage": "https://github.com/wharfie/wharfie#readme",
  "packageManager": "npm@11.12.0",
  "engineStrict": true,
  "engines": {
    "node": "24.13.1"
  },
  "main": "./src/cli/entry.js",
  "exports": {
    ".": "./src/cli/entry.js",
    "./app": {
      "types": "./src/app.d.ts",
      "import": "./src/app.js",
      "default": "./src/app.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "bin/",
    "scripts/**",
    "src/app.js",
    "src/app.d.ts",
    "src/core/**",
    "src/cli/**"
  ],
  "scripts": {
    "typecheck": "tsc",
    "test:js": "TZ=UTC node ./test/run-jest.js --silent --coverage",
    "test:update": "TZ=UTC node ./test/run-jest.js --silent --updateSnapshot",
    "test": "TZ=UTC node ./test/run-jest.js --silent --coverage",
    "test:ci": "npm run lint && npm run typecheck && npm run test && npm run verify:package",
    "lint:js": "eslint . && prettier --check \"{*,**/*}.{js,json}\"",
    "lint": "npm run lint:js",
    "lint:fix": "eslint --fix . && prettier --write \"{*,**/*}.{js,json}\"",
    "verify:package": "node ./scripts/verify-package-contents.js",
    "verify:package:sea": "node ./scripts/verify-package-sea.js",
    "verify:release-ready": "node ./scripts/verify-release-ready.js",
    "verify:release-version": "node ./scripts/verify-release-version.js",
    "verify:release-unpublished": "node ./scripts/verify-release-unpublished.js"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/core/runtime/**/*.js",
      "src/core/resources/builds/**/*.js",
      "src/core/lib/code-execution/**/*.js"
    ],
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/mock/builds/"
    ],
    "testMatch": [
      "<rootDir>/test/cli/**/*.test.js",
      "<rootDir>/test/runtime/**/*.test.js",
      "<rootDir>/test/graph/**/*.test.js",
      "<rootDir>/test/db/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "es2020": true,
      "node": true
    },
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "requireConfigFile": false,
      "ecmaVersion": "latest",
      "sourceType": "module",
      "babelOptions": {
        "plugins": [
          "@babel/plugin-syntax-import-attributes"
        ]
      }
    },
    "plugins": [
      "jsdoc"
    ],
    "ignorePatterns": [
      "dist/",
      "tmp/",
      "docs/",
      "src/cli/",
      "test/",
      "scratch/",
      "coverage/"
    ],
    "overrides": [
      {
        "files": [
          "test/**"
        ],
        "plugins": [
          "jest"
        ],
        "extends": [
          "plugin:jest/all"
        ],
        "rules": {
          "jest/max-expects": 0,
          "jest/no-conditional-in-test": 0
        }
      }
    ],
    "extends": [
      "plugin:jsdoc/recommended",
      "plugin:n/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript",
      "eslint-config-standard",
      "prettier"
    ],
    "settings": {
      "jsdoc": {
        "mode": "typescript"
      },
      "import/resolver": {
        "typescript": {
          "project": "./tsconfig.json"
        },
        "node": {
          "extensions": [
            ".js",
            ".ts",
            ".d.ts"
          ]
        }
      }
    },
    "rules": {
      "import/no-dynamic-require": "error",
      "jsdoc/check-types": "off",
      "camelcase": "off",
      "no-template-curly-in-string": "off",
      "jsdoc/no-undefined-types": [
        "error",
        {
          "definedTypes": [
            "Iterable",
            "AsyncIterable"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-syntax-import-attributes": "^7.27.1",
    "@jest/globals": "^30.2.0",
    "@types/diff": "^5.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/npmcli__arborist": "^6.3.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-jsdoc": "^44.0.0",
    "eslint-plugin-n": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.363.0",
    "@aws-sdk/client-s3": "^3.363.0",
    "@aws-sdk/client-sqs": "^3.363.0",
    "@aws-sdk/credential-providers": "^3.363.0",
    "@aws-sdk/lib-dynamodb": "^3.365.0",
    "@grpc/grpc-js": "^1.14.3",
    "@npmcli/arborist": "^9.1.4",
    "@paralleldrive/cuid2": "^2.2.2",
    "@smithy/util-retry": "^3.0.3",
    "chalk": "^4.1.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "env-paths": "^2.2.1",
    "es-toolkit": "^1.13.1",
    "esbuild": "0.25.1",
    "jszip": "^3.10.1",
    "lmdb": "^3.4.0",
    "pacote": "^21.0.3",
    "postject": "^1.0.0-alpha.6",
    "semver": "^7.6.3",
    "source-map-support": "^0.5.21",
    "tar": "^7.4.3",
    "uuid": "^11.1.0"
  }
}
