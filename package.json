{
  "name": "@wharfie/wharfie",
  "version": "0.0.15",
  "description": "Experimental toolkit for building TypeScript CLIs and packaging them as portable Node SEA executables",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wharfie/wharfie.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wharfie/wharfie/issues"
  },
  "bin": {
    "wharfie": "./bin/wharfie"
  },
  "homepage": "https://github.com/wharfie/wharfie#readme",
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": "24.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.12.0",
      "onFail": "error"
    }
  },
  "main": "./src/cli/entry.js",
  "exports": {
    ".": "./src/cli/entry.js",
    "./app": {
      "types": "./src/app.d.ts",
      "import": "./src/app.js",
      "default": "./src/app.js"
    },
    "./deployment-profile": {
      "types": "./src/deployment-profile.d.ts",
      "import": "./src/deployment-profile.js",
      "default": "./src/deployment-profile.js"
    },
    "./single-node-deployment": {
      "types": "./src/single-node-deployment.d.ts",
      "import": "./src/single-node-deployment.js",
      "default": "./src/single-node-deployment.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "bin/",
    "src/app.js",
    "src/app.d.ts",
    "src/deployment-profile.js",
    "src/deployment-profile.d.ts",
    "src/single-node-deployment.js",
    "src/single-node-deployment.d.ts",
    "src/core/**",
    "src/cli/**",
    "examples/README.md",
    "examples/hello-world/",
    "examples/steady-file/"
  ],
  "scripts": {
    "typecheck": "npm run typecheck:source && npm run typecheck:app && npm run typecheck:test && npm run typecheck:sea-verifier",
    "typecheck:source": "tsc -p tsconfig.json",
    "typecheck:app": "tsc -p tsconfig.app-implementation.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:sea-verifier": "tsc -p tsconfig.sea-verifier.json",
    "test:js": "TZ=UTC node ./test/run-jest.js --silent",
    "test:update": "TZ=UTC node ./test/run-jest.js --silent --updateSnapshot",
    "test": "TZ=UTC node ./test/run-jest.js --silent",
    "test:coverage": "TZ=UTC node ./test/run-jest.js --silent --coverage",
    "test:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run verify:package && npm run audit:prod",
    "test:native": "WHARFIE_RUN_NATIVE_EXTERNALS=1 TZ=UTC node ./test/run-jest.js --silent --runInBand test/cli/app/kitchen-sink-native-externals.test.js",
    "test:full": "npm run test:ci && npm run test:native && npm run verify:package:sea",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "lint:js": "eslint --max-warnings=0 . && prettier --check \"{*,**/*}.{js,json}\"",
    "lint": "npm run lint:js",
    "lint:fix": "eslint --max-warnings=0 --fix . && prettier --write \"{*,**/*}.{js,json}\"",
    "verify:package": "node ./scripts/verify-package-contents.js",
    "verify:magnetic-first-run": "node ./scripts/verify-magnetic-first-run.js",
    "verify:package:sea": "node ./scripts/verify-package-sea.js",
    "verify:service:systemd:lima": "./scripts/run-systemd-user-service-lima.sh",
    "verify:steady-file:systemd:lima": "./scripts/run-steady-file-preview-lima.sh",
    "verify:host:retained-storage:preflight": "node ./scripts/collect-aws-host-retained-storage-preflight-linux.js",
    "verify:host:retained-storage:preflight:sea:linux:docker:readiness": "node ./scripts/inspect-aws-host-retained-storage-host-preflight-sea-linux-docker-readiness.js",
    "verify:host:retained-storage:preflight:sea:linux:docker": "node ./scripts/run-aws-host-retained-storage-host-preflight-sea-linux-docker.js",
    "package:host:retained-storage:preflight:sea": "node ./scripts/aws-host-retained-storage-host-preflight-sea-package.js"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 75,
        "statements": 75
      }
    },
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "es2020": true,
      "node": true
    },
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "requireConfigFile": false,
      "ecmaVersion": "latest",
      "sourceType": "module",
      "babelOptions": {
        "plugins": [
          "@babel/plugin-syntax-import-attributes"
        ]
      }
    },
    "plugins": [
      "jsdoc"
    ],
    "ignorePatterns": [
      "dist/",
      "tmp/",
      "scratch/",
      "coverage/"
    ],
    "overrides": [
      {
        "files": [
          "examples/hello-world/**"
        ],
        "rules": {
          "jsdoc/require-jsdoc": 0
        }
      },
      {
        "files": [
          "examples/hello-world/**/wharfie.app.js"
        ],
        "rules": {
          "import/no-unresolved": 0,
          "n/no-missing-import": 0
        }
      },
      {
        "files": [
          "test/**"
        ],
        "plugins": [
          "jest"
        ],
        "extends": [
          "plugin:jest/recommended"
        ],
        "rules": {
          "jest/max-expects": 0,
          "jest/no-conditional-in-test": 0,
          "jest/no-conditional-expect": 0,
          "jest/no-standalone-expect": 0,
          "import/namespace": 0,
          "import/no-dynamic-require": 0,
          "jsdoc/no-undefined-types": 0,
          "jsdoc/require-jsdoc": 0,
          "jsdoc/require-param": 0,
          "jsdoc/require-param-description": 0,
          "jsdoc/require-returns": 0,
          "jsdoc/require-returns-description": 0,
          "jsdoc/tag-lines": 0,
          "n/no-process-exit": 0
        }
      }
    ],
    "extends": [
      "plugin:jsdoc/recommended",
      "plugin:n/recommended",
      "plugin:import/recommended",
      "eslint-config-standard",
      "prettier"
    ],
    "settings": {
      "jsdoc": {
        "mode": "typescript"
      },
      "import/resolver": {
        "node": {
          "extensions": [
            ".js",
            ".ts",
            ".d.ts"
          ]
        }
      }
    },
    "rules": {
      "import/no-dynamic-require": "error",
      "jsdoc/check-types": "off",
      "camelcase": "off",
      "no-template-curly-in-string": "off",
      "jsdoc/no-undefined-types": [
        "error",
        {
          "definedTypes": [
            "Iterable",
            "AsyncIterable",
            "NodeJS"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-syntax-import-attributes": "^7.27.1",
    "@jest/globals": "^30.4.1",
    "@types/diff": "^5.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/npmcli__arborist": "^6.3.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-jsdoc": "^44.0.0",
    "eslint-plugin-n": "^16.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.7.4",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-ec2": "^3.1091.0",
    "@aws-sdk/client-iam": "^3.1092.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/client-ssm": "^3.1091.0",
    "@aws-sdk/client-sts": "^3.1091.0",
    "@aws-sdk/credential-providers": "^3.1090.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "@babel/parser": "^7.28.5",
    "@npmcli/arborist": "^9.9.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@smithy/util-retry": "^3.0.3",
    "chalk": "^4.1.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "env-paths": "^2.2.1",
    "es-toolkit": "^1.13.1",
    "esbuild": "0.25.1",
    "jszip": "^3.10.1",
    "lmdb": "^3.4.0",
    "pacote": "^21.5.1",
    "postject": "^1.0.0-alpha.6",
    "semver": "^7.6.3",
    "source-map-support": "^0.5.21",
    "tar": "^7.5.20"
  }
}
