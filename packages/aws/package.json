{
  "name": "@wharfie/aws",
  "version": "0.0.15",
  "description": "Version-matched AWS deployment companion for Wharfie",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wharfie/wharfie.git",
    "directory": "packages/aws"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.13.1"
  },
