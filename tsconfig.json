{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": [
    "src/app.d.ts",
    "src/deployment-profile.js",
    "src/deployment-profile.d.ts",
    "src/core/**/*.js",
    "src/cli/**/*.js",
    "scripts/aws-host-retained-storage-host-preflight.js",
    "scripts/collect-aws-host-retained-storage-preflight-linux.js",
    "scripts/package-verification.js",
    "scripts/sea-inspector.js",
    "scripts/verify-package-contents.js",
    "types/**/*.d.ts"
  ]
}
